# ===== 后厨管家 AI 问数 · 服务配置 =====
# 复制为 .env 后按需修改。所有项均可不填（使用默认值）。

# 应用签名密钥（必填，用于会话 Cookie 签名）。
# 留空会自动生成并落盘 data/.app_secret；生产环境请显式设置一个强随机值。
# APP_SECRET=请替换为一段足够长的随机字符串

# 监听地址与端口。服务器部署建议 HOST=0.0.0.0
HOST=0.0.0.0
PORT=8011

# 腾讯混元大模型（不填则自动走本地 MockLLM，仅用于无密钥演示）
HUNYUAN_SECRET_ID=
HUNYUAN_SECRET_KEY=
HUNYUAN_MODEL=hunyuan-turbo

# ===== 腾讯 MaaS tokenhub 等 OpenAI 兼容网关（推荐，最简单）=====
# 设了 MAAS_API_KEY 即走真实模型，且默认启用「多模型轮询降级」：
#   按 MAAS_MODELS 顺序尝试候选模型，某模型额度/限流/不可用时自动切到下一个，
#   全部失败才报错；一次成功后会优先复用该模型以降低延迟。
# 优先级：MOCK_LLM=1 > MAAS(多模型链路) > 原生混元 > Mock。
MAAS_API_KEY=
MAAS_BASE_URL=https://tokenhub.tencentmaas.com/v1
# 候选模型列表（逗号分隔），按顺序轮询降级。建议保留多模型以自动容错。
# 不填则使用内置默认列表（共 14 个：kimi-k3 / glm-5.2 / deepseek-v4 系列 /
#   minimax-m3 / qwen3.5-flash / mimo-v2.5-pro / hy-mt2-pro / glm-5.1 / glm-5v-turbo 等）。
# 以下为与当前生产一致的推荐配置：
MAAS_MODELS=kimi-k3,kimi-k2.7-code-highspeed,glm-5.2,kimi-k2.7-code,minimax-m3,deepseek-v4-flash-202605,deepseek-v4-pro-202606,deepseek-v4-flash,deepseek-v4-pro,hy-mt2-pro,mimo-v2.5-pro,qwen3.5-flash,glm-5.1,glm-5v-turbo
# 单一模型模式（不推荐）：仅当 MAAS_MODELS 为空时生效；留空且未设 MAAS_MODELS
# 则回退到内置 14 模型列表。
MAAS_MODEL=hy3

# 后厨管家接口地址（生产环境）
HCG_BASE_URL=https://api.houchuguanjia.com/

# 若通过 HTTPS 反向代理（nginx 等）访问，设为 1 以给 Cookie 加 Secure 标志
SESSION_SECURE=0

# 强制使用本地 MockLLM（无密钥也能跑通全流程演示），设为 1 开启
MOCK_LLM=0
