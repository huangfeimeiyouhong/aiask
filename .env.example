# ===== 后厨管家 AI 问数 · 服务配置 =====
# 复制为 .env 后按需修改。所有项均可不填（使用默认值）。

# 应用签名密钥（必填，用于会话 Cookie 签名）。
# 留空会自动生成并落盘 data/.app_secret；生产环境请显式设置一个强随机值。
# APP_SECRET=请替换为一段足够长的随机字符串

# 监听地址与端口。服务器部署建议 HOST=0.0.0.0
HOST=0.0.0.0
PORT=8011

# 腾讯混元大模型（不填则自动走本地 MockLLM，仅用于无密钥演示）
HUNYUAN_SECRET_ID=
HUNYUAN_SECRET_KEY=
HUNYUAN_MODEL=hunyuan-turbo

# ===== 腾讯 MaaS tokenhub 等 OpenAI 兼容网关（推荐，最简单）=====
# 设了 MAAS_API_KEY 即走真实模型（默认 hy3），无需 TC3 签名。
# 优先级：MOCK_LLM=1 > MAAS > 原生混元 > Mock。
MAAS_API_KEY=
MAAS_BASE_URL=https://tokenhub.tencentmaas.com/v1
MAAS_MODEL=hy3

# 后厨管家接口地址（生产环境）
HCG_BASE_URL=https://api.houchuguanjia.com/

# 若通过 HTTPS 反向代理（nginx 等）访问，设为 1 以给 Cookie 加 Secure 标志
SESSION_SECURE=0

# 强制使用本地 MockLLM（无密钥也能跑通全流程演示），设为 1 开启
MOCK_LLM=0
